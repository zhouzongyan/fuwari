---
import { getCustomStaticPaths } from "@utils/content-utils";
// SSG 必须有
export async function getStaticPaths() {
	await getCustomStaticPaths();
	return [];
}

const slug = Astro.params.slug.split("/").map((p) => encodeURIComponent(p));
const targetUrl = `/posts/${slug.join("/")}/`;
---
<html>
  <head>
    <title>Redirecting...</title>
    <meta http-equiv="refresh" content={`0; url=${targetUrl}`} />
    <script>window.location.href = {targetUrl}</script>
  </head>
  <body>
    Redirecting to <a href="{targetUrl}">{targetUrl}</a>
  </body>
</html>
